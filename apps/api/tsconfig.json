{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",

		"outDir": "./dist",
		"rootDir": "./src",

		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,

		"paths": {
			"@chat/config": ["../../packages/config/src/index.ts"],
			"@chat/db": ["../../packages/db/src/index.ts"],
			"@chat/schema": ["../../packages/schema/src/index.ts"],
			"@chat/types": ["../../packages/types/src/index.ts"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
